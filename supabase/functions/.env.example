# Edge function variables for local development. Copy to
# supabase/functions/.env (git-ignored); both `supabase start` and
# `supabase functions serve` read it. On the hosted project the same names
# are function secrets (`supabase secrets set`), never committed.

# --- Email (edge functions) ---------------------------------------------------
# Resend API key the sender uses. Not needed while EMAIL_DRY_RUN=true.
RESEND_API_KEY=
# Address mail is sent from, on Resend's verified sending domain.
EMAIL_FROM=
# Mailbox replies go to; replies never reach the app.
EMAIL_REPLY_TO=
# The shop's own inbox, for mail addressed to the business.
EMAIL_SHOP_TO=
# Proves a delivery report really came from Resend (email-webhook): the
# endpoint's signing secret from the Resend dashboard, `whsec_` + base64.
# Locally any value of that shape will do — the e2e suite signs the reports it
# posts with the same value, which the runner reads from this file.
RESEND_WEBHOOK_SECRET=
# true: the sender skips Resend and records provider_id 'dry-run'. Keep it true
# locally unless a real send is wanted; never set it on the hosted project.
EMAIL_DRY_RUN=true

# --- Customer approval --------------------------------------------------------
# The customer app's public origin (the static page the approval link opens).
# The approval-request mail's link is this plus `/approval#<token>`; a sender
# without it gives the request mail up. Any origin will do locally.
CUSTOMER_APP_URL=http://localhost:3000
