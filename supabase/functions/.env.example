# Edge function variables for local development. Copy to
# supabase/functions/.env (git-ignored); both `supabase start` and
# `supabase functions serve` read it. On the hosted project the same names
# are function secrets (`supabase secrets set`), never committed.

# --- Email (edge functions) ---------------------------------------------------
# The email provider's (AhaSend) API key the sender uses: an API Key v2 scoped
# to messages:send:<sending domain>. Not needed while EMAIL_DRY_RUN=true.
EMAIL_API_KEY=
# The provider account the key belongs to (AhaSend's account UUID). Not
# needed while EMAIL_DRY_RUN=true.
EMAIL_ACCOUNT_ID=
# Address mail is sent from, on the provider's verified sending domain —
# `Name <address>` or a bare address.
EMAIL_FROM=
# Mailbox replies go to; replies never reach the app.
EMAIL_REPLY_TO=
# The shop's own inbox, for mail addressed to the business.
EMAIL_SHOP_TO=
# Proves a delivery report really came from the provider (email-webhook): the
# webhook's signing secret from the AhaSend dashboard, exactly as shown,
# `aha-whsec-` prefix included. Locally any value will do — the e2e suite
# signs the reports it posts with the same value, which the runner reads from
# this file.
EMAIL_WEBHOOK_SECRET=
# true: the sender skips the provider and records provider_id 'dry-run'. Keep it true
# locally unless a real send is wanted; never set it on the hosted project.
EMAIL_DRY_RUN=false

# --- Customer approval --------------------------------------------------------
# The customer app's public origin (the static page the approval link opens).
# The approval-request mail's link is this plus `/approval#<token>`; a sender
# without it gives the request mail up. customer-approval allows this origin
# (CORS) and does not start without it. Locally, the customer app's dev
# server: `npm run dev` in markus/customer-app serves on port 3741.
CUSTOMER_APP_URL=http://localhost:3741
