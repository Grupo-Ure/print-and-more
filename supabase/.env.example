# Local stack variables. Copy to supabase/.env (git-ignored); `supabase start`
# reads it for the `[db.vault]` section of config.toml, which fills the local
# Vault the drain cron reads. Hosted entries (`project_url`,
# `service_role_key`) are added by hand and are not set from this file.

# Base URL of the API as the postgres container reaches it: the host's API
# port from config.toml, via host.docker.internal.
DRAIN_PROJECT_URL=http://host.docker.internal:55321
# The legacy JWT service_role key from `supabase status` — not the sb_secret_…
# one, because send-email compares the bearer token with the runtime's
# SUPABASE_SERVICE_ROLE_KEY.
DRAIN_SERVICE_ROLE_KEY=
