# Copy to .env and fill in. `VITE_`-prefixed values are inlined into the build
# (renderer and Electron main) — never put secrets behind that prefix.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# End-to-end test runner only (never VITE_-prefixed, never in the bundle):
# creates and removes the suite's test data. For a local Supabase, copy the
# service_role key from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry error tracking (optional) -----------------------------------------
# Leave VITE_SENTRY_DSN empty to disable Sentry entirely.
# DSN from: Sentry → Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Optional environment tag. Defaults to production/development (Electron) or
# Vite's mode (browser). Useful to keep e2e/test builds out of the real data.
VITE_SENTRY_ENVIRONMENT=

# Source-map upload at build time (build machine / CI only, not shipped).
# Upload is skipped unless all three are set.
# Auth token from: Sentry → Settings → Auth Tokens (scope: project:releases, org:read)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
